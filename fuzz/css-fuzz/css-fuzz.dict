# css-fuzz dictionary — at-keywords, functions, selectors, structural tokens
# Compatible with libFuzzer / AFL -x style keyword files.

# Structural
brace_open="{"
brace_close="}"
paren_open="("
paren_close=")"
bracket_open="["
bracket_close="]"
colon=":"
semicolon=";"
comma=","
at="@"
bang="!"
amp="&"
star="*"
hash="#"
dot="."
gt=">"
plus="+"
tilde="~"
pipe="|"
dq="\""
sq="'"
cdo="<!--"
cdc="-->"

# At-keywords
at_media="@media"
at_supports="@supports"
at_keyframes="@keyframes"
at_import="@import"
at_namespace="@namespace"
at_font_face="@font-face"
at_layer="@layer"
at_property="@property"
at_container="@container"
at_scope="@scope"
at_page="@page"
at_charset="@charset"
at_font_feature="@font-feature-values"
at_counter="@counter-style"
at_starting="@starting-style"
at_view="@view-transition"

# Functions / values
fn_calc="calc("
fn_var="var("
fn_url="url("
fn_rgb="rgb("
fn_rgba="rgba("
fn_hsl="hsl("
fn_color_mix="color-mix("
fn_min="min("
fn_max="max("
fn_clamp="clamp("
fn_attr="attr("
fn_env="env("
important="!important"
css_wide_inherit="inherit"
css_wide_initial="initial"
css_wide_unset="unset"

# Selectors
pseudo_hover=":hover"
pseudo_nth=":nth-child("
pseudo_is=":is("
pseudo_where=":where("
pseudo_not=":not("
pseudo_has=":has("
pseudo_before="::before"
pseudo_after="::after"
attr_eq="="
attr_star="*="
attr_caret="^="
attr_dollar="$="
attr_tilde="~="
attr_pipe="|="

# Comments / strings / encoding
comment_open="/*"
comment_close="*/"
bom_utf8="\xEF\xBB\xBF"
nul="\x00"
overlong="\xC0\xAF"
never_utf8="\xFF"

# Custom properties / nesting
custom_prop="--"
nest_amp="&"
from="from"
to="to"
and="and"
or="or"
not="not"
only="only"
